        },
        "side": {
          "class": "OWNER_RECORD"
        },
        "qty": {
          "class": "OWNER_RECORD",
          "note": "the owner's position size (own transaction record)"
        },
        "qty_available": {
          "class": "OWNER_RECORD"
        },
        "avg_entry_price": {
          "class": "OWNER_RECORD",
          "note": "own average entry price: the owner's transaction record; owner ruling pending on treating own execution prices as owner records",
          "review": true
        },
        "cost_basis": {
          "class": "OWNER_RECORD",
          "note": "own cost basis (qty x own entry price): the owner's transaction record; owner ruling pending",
          "review": true
        },
        "current_price": {
          "class": "MARKET_DATA",
          "note": "latest market price"
        },
        "market_value": {
          "class": "MARKET_DATA",
          "note": "qty x current market price: marked to market"
        },
        "unrealized_pl": {
          "class": "MARKET_DATA",
          "note": "marked to market"
        },
        "unrealized_plpc": {
          "class": "MARKET_DATA",
          "note": "marked to market"
        },
        "unrealized_intraday_pl": {
          "class": "MARKET_DATA",
          "note": "marked to market"
        },
        "unrealized_intraday_plpc": {
          "class": "MARKET_DATA",
          "note": "marked to market"
        },
        "change_today": {
          "class": "MARKET_DATA",
          "note": "market-price change"
        },
        "lastday_price": {
          "class": "MARKET_DATA",
          "note": "prior-day market close"
        },
        "asset_marginable": {
          "class": "MARKET_DATA",
          "note": "vendor reference attribute (conservative)"
        }
