{
  "Version": "2008-10-17",
  "Id": "__default_policy_ID",
  "Statement": [
    {
      "Sid": "__default_statement_ID",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": [
        "SNS:GetTopicAttributes",
        "SNS:SetTopicAttributes",
        "SNS:AddPermission",
        "SNS:RemovePermission",
        "SNS:DeleteTopic",
        "SNS:Subscribe",
        "SNS:ListSubscriptionsByTopic",
        "SNS:Publish"
      ],
      "Resource": "arn:aws:sns:us-east-1:219024422756:workbench-paper-alarms",
      "Condition": {
        "StringEquals": {
          "AWS:SourceOwner": "219024422756"
        }
      }
    },
    {
      "Sid": "AllowEventBridgePublishMR002Custody",
      "Effect": "Allow",
      "Principal": {
        "Service": "events.amazonaws.com"
      },
      "Action": "SNS:Publish",
      "Resource": "arn:aws:sns:us-east-1:219024422756:workbench-paper-alarms",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": "219024422756"
        }
      }
    }
  ]
}
