{
  "Version": "2012-10-17",
  "Id": "MR002SealedStorePolicy",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::workbench-mr002-sealed-219024422756",
        "arn:aws:s3:::workbench-mr002-sealed-219024422756/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "DenyValidation2ReadsToEveryPrincipalButGovernedValidationReader",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "s3:GetObjectVersionAttributes"
      ],
      "Resource": "arn:aws:s3:::workbench-mr002-sealed-219024422756/oos/*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalArn": "arn:aws:iam::219024422756:role/mr002-validation-reader"
        }
      }
    },
    {
      "Sid": "DenyValidationReadsToEveryPrincipalButTheValidationReader",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "s3:GetObjectVersionAttributes"
      ],
      "Resource": "arn:aws:s3:::workbench-mr002-sealed-219024422756/validation/*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalArn": "arn:aws:iam::219024422756:role/mr002-validation-reader"
        }
      }
    },
    {
      "Sid": "DenyPermanentDeletionOfSealedObjectVersions",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:DeleteObjectVersion",
        "s3:PutBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::workbench-mr002-sealed-219024422756",
        "arn:aws:s3:::workbench-mr002-sealed-219024422756/validation/*",
        "arn:aws:s3:::workbench-mr002-sealed-219024422756/oos/*"
      ]
    }
  ]
}
