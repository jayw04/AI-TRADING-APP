{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCustodyRepositoryOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:BatchGetImage",
        "ecr:GetLifecyclePolicy",
        "ecr:ListImages",
        "ecr:GetRepositoryPolicy"
      ],
      "Resource": "arn:aws:ecr:us-east-1:219024422756:repository/mr002-evaluator-p5"
    },
    {
      "Sid": "WriteReceiptsOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::workbench-backups-219024422756/mr002/custody/receipts/*"
    },
    {
      "Sid": "AlertOnly",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:219024422756:workbench-paper-alarms"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:219024422756:*"
    }
  ]
}
