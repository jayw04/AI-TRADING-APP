{
  "Version": "2012-10-17",
  "Id": "WorkbenchBackupsConsumedHoldoutCustody",
  "Statement": [
    {
      "Sid": "DenyTheEvaluatorAndResearchPlanesEveryConsumedHoldoutMaterialization",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "s3:GetObjectVersionAttributes"
