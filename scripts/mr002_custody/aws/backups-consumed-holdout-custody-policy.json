      "Resource": [
        "arn:aws:s3:::workbench-backups-219024422756/mr002/consumed-validation1-custody/*",
        "arn:aws:s3:::workbench-backups-219024422756/mr002/consumed-validation2-custody/*"
      ],
      "Condition": {
