 "record_identity_sha256": "43e6acfb7732c37336fb0d7817c202225e2b773926bef9183ec5e04a3bf6c14c",
 "record_type": "MR002_Validation2_AmendmentA_DenyLayerCorrection",
 "rerun_requirement": "the FULL readiness matrix must be re-run from scratch after application, not only the seven failed cells - changing deny structure can break a previously passing positive cell. The ListBucket cell is fixed in the TEST HARNESS (supply s3:prefix), never by changing the policy, and the original failed observation is retained in the historical record.",
 "scope": "DENY LAYER ONLY. No Allow, trust, latch or Amendment-B control is altered.",
 "status": "DRAFT PROPOSAL - NOT APPLIED",
 "supersedes": {
  "failing_matrix_identity": "5e39ff64d8bef7af5de2462d4fafa56b0bece691994364e33524fdccb5c8c033",
  "preserved": "v1.0 and its readiness matrix 5e39ff64... are retained UNMODIFIED. The deployment never permitted an unintended read; the defect is failure to meet the registered EXPLICIT-deny strength, not a security breach.",
  "record": "Amendment A v1.0",
  "status": "APPLIED, SAFE BUT INSUFFICIENTLY STRONG"
 },
 "the_correction": {
  "added_six_per_key_denies": [
   "DenyValidation2<Key>AtAnyVersionButItsOwn - Deny s3:GetObjectVersion on exactly that key, Condition StringNotEquals s3:VersionId = that key's OWN registered version"
  ],
  "added_unregistered_object_deny": "DenyVersionedReadOfAnythingButTheSixRegisteredObjects",
  "allow_layer": "UNCHANGED (8 statements, byte-identical modulo condition-key casing)",
  "removed": [
   "DenyValidation2AtAnyUnregisteredVersion (the shared-list deny)"
  ]
 },
 "unregistered_object_deny_construction": {
  "RISK_DISCLOSED": "Deny + NotResource is a known footgun because it denies everything outside the list. Mitigations: it is scoped to ONE action, so its blast radius is a single verb and it cannot touch ListBucket, GetObject, writes or any non-S3 call; the exception list is short and explicit; and every negative case is testable.",
  "expression": "Deny s3:GetObjectVersion with NotResource = [the six keys, development/*, reference/*]",
  "fact": "oos/ currently holds exactly 6 objects, so this statement is DEFENSIVE against a future addition rather than covering anything that exists today - which is exactly why it must be explicitDeny and not 'there is nothing else there'.",
  "gap_it_closes": "DenyEveryActionOnValidation2ExceptPinnedVersionReads already denies all NON-GetObjectVersion actions on oos/*, and the six per-key denies handle wrong versions on REGISTERED keys. The only survivor was GetObjectVersion on an UNREGISTERED oos key.",
  "why_NotResource": "IAM has no 'wildcard except these ARNs' operator. This is the only mechanically sound expression of the required invariant."
 },
