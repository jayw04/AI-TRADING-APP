{
 "action_scoping_rationale": {
  "owner_caution_applied": "the per-key denies are scoped to s3:GetObjectVersion, NOT s3:*",
  "registered_subtlety": "StringNotEquals against an ABSENT context key evaluates TRUE, so a GetObjectVersion carrying NO version on key K also hits K's deny. That is intended, and is added as an explicit test cell rather than left implied.",
  "why": "a Deny s3:* carrying a VersionId condition behaves confusingly for operations that do not supply that context key. Ordinary GetObject, writes and deletes are left to the existing UNCONDITIONAL denies, which already return explicitDeny for them."
 },
