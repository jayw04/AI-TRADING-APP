 "defect_class": {
  "description": "sha256 recorded as a governance/execution binding was computed by reading the file from the Windows working tree, where core.autocrlf yields CRLF. The recorded value is therefore a PLATFORM identity, not a CONTENT identity, and fail-closes against any LF materialization of the same source. All affected values are representation-only: every file is byte-equal to its Git blob after removing carriage returns.",
  "detected_by": "active-chain governance-hash sweep, 2026-08-18",
  "first_failure": "2026-08-18 Phase 3C latch cycle \u2014 AdoptionBindingViolation at import, before reader construction, before STS, before any sealed GetObject",
  "name": "GOVERNANCE_HASH_DERIVED_FROM_WINDOWS_WORKING_TREE",
  "prior_isolated_corrections_of_the_same_class": [
   "v3.5 provenance retirement (CRLF custody drift on 4 members)",
   "*_published/ directories missing '* -text -diff' in .gitattributes",
   "MR002_Stage3_ExecutionPackage v2.0 -> v2.1 identity correction",
   "git archive applying CRLF to the Phase 3C launcher (fixed with -c core.eol=lf)"
  ]
 },
