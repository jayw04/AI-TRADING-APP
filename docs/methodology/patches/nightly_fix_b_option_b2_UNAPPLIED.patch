+"""Unit tests for scripts/check_dependency_locks.py re-resolution helpers (nightly defect B).
+
+The root `scripts/` package is not on the backend import path, so the module is loaded by file path.
+Offline only: no uv, no network.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import subprocess
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parents[4]
+_spec = importlib.util.spec_from_file_location(
+    "check_dependency_locks", REPO_ROOT / "scripts" / "check_dependency_locks.py"
+)
+assert _spec is not None and _spec.loader is not None
+cdl = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(cdl)
+
+BODY = "foo==1.0 \\\n    --hash=sha256:" + "a" * 64 + "\n    # via bar\n"
+HEADER = "# GENERATED FILE - DO NOT EDIT BY HAND.\n#\n# more header\n#\n"
+
+
+def test_strip_header_removes_only_the_leading_block() -> None:
+    assert cdl.strip_header(HEADER + BODY) == BODY
+
+
+def test_strip_header_is_identity_without_a_header() -> None:
+    assert cdl.strip_header(BODY) == BODY
+
+
+def test_strip_header_keeps_indented_via_comments() -> None:
+    assert "    # via bar" in cdl.strip_header(HEADER + BODY)
+
+
+@pytest.mark.parametrize("project", sorted(cdl.PROJECTS))
+def test_every_real_committed_file_strips_to_its_first_pin(project: str) -> None:
+    body = cdl.strip_header(cdl.constraints_path(project).read_text(encoding="utf-8"))
+    assert cdl.PIN_RE.match(body), "header stripping must land exactly on the first pinned package"
+
+
+def test_recompile_seeds_uv_with_the_committed_body_and_never_upgrades(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    seen: dict[str, object] = {}
+
+    def run(cmd: list[str], **kwargs: object) -> subprocess.CompletedProcess[str]:
+        out = Path(cmd[cmd.index("--output-file") + 1])
+        seen["seed"] = out.read_text(encoding="utf-8")
+        seen["cmd"] = cmd
+        return subprocess.CompletedProcess(cmd, 0, "", "")
+
+    monkeypatch.setattr(cdl.subprocess, "run", run)
+    ok, _ = cdl.recompile_one("backend", "apps/backend", tmp_path / "o.txt", seed=BODY)
+    cmd = seen["cmd"]
+    assert ok and seen["seed"] == BODY
+    assert isinstance(cmd, list)
+    assert "--upgrade" not in cmd and "-U" not in cmd
+    assert "--no-header" in cmd
+
+
+def test_recompile_without_seed_does_not_touch_the_output_path(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    monkeypatch.setattr(
+        cdl.subprocess, "run", lambda cmd, **k: subprocess.CompletedProcess(cmd, 0, "", "")
+    )
+    out = tmp_path / "o.txt"
+    cdl.recompile_one("backend", "apps/backend", out)
+    assert not out.exists()
+
+
+def test_offline_structural_gate_still_passes() -> None:
+    assert cdl.main([]) == 0
