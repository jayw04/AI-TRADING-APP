# Force LF for files that EXECUTE on Linux (the EC2 box). The dev machine is Windows
# with core.autocrlf=true, which makes `git archive` inject CRLF into shell scripts and
# systemd units → `$'\r': command not found` / `set: pipefail<CR>: invalid option` at
# runtime on the box. eol=lf pins LF in the working tree AND in `git archive` output,
# independent of the local autocrlf setting. (Found 2026-06-30 during the CloudWatch
# publisher deploy; protects the ADR-0032 cutover scripts too.)
*.sh      text eol=lf
*.service text eol=lf
*.timer   text eol=lf

# Repo-wide binary formats. Never EOL-converted anywhere.
*.gz      binary
*.zip     binary
*.npz     binary
*.parquet binary
*.duckdb  binary
*.sqlite  binary
*.xlsx    binary
*.docx    binary
*.pptx    binary
*.pdf     binary
*.png     binary
*.jpg     binary

# ======================================================================================
# MR-002 EVIDENCE TREE — text is a WHITELIST, not a default.
#
# The previous policy was a single line:
#
#     docs/implementation/evidence/mr_002/**   text eol=lf
#
# written to protect the countersigned markdown, whose SHA-256 binding is over LF bytes. But `**`
# matches EVERYTHING in the tree, including the gzipped archives. Git marked them text, and its
# clean filter strips the CR from any CRLF byte pair occurring inside the COMPRESSED STREAM — where
# 0d 0a is data, not a line ending. Seven of the nine archives carry such pairs (anchors.csv.gz has
# 8; raw_response_manifest.jsonl.gz has 48). A single `git add` would have deleted those bytes and
# destroyed the archive. They showed as permanently "modified" while being byte-identical to HEAD,
# which is the symptom of precisely this.
#
# Blacklisting the binary extensions fixes today's tree and re-arms the trap for tomorrow's: the
# next `.zip`, `.npz` or `.pkl` dropped in here would be matched by `**` and by no binary rule.
#
# So the default for this tree is NO CONVERSION, and the text formats are named explicitly. A new
# binary format is then safe by default, and a new TEXT format simply is not normalized until
# someone adds it here — which is the failure that costs nothing.
# ======================================================================================
docs/implementation/evidence/mr_002/**              -text

docs/implementation/evidence/mr_002/*.md            text eol=lf
docs/implementation/evidence/mr_002/*.json          text eol=lf
docs/implementation/evidence/mr_002/*.csv           text eol=lf
docs/implementation/evidence/mr_002/*.txt           text eol=lf
docs/implementation/evidence/mr_002/*.sha256        text eol=lf
docs/implementation/evidence/mr_002/**/*.md         text eol=lf
docs/implementation/evidence/mr_002/**/*.json       text eol=lf
docs/implementation/evidence/mr_002/**/*.csv        text eol=lf
docs/implementation/evidence/mr_002/**/*.txt        text eol=lf
docs/implementation/evidence/mr_002/**/*.sha256     text eol=lf

# The countersigned pre-registration: the owner's countersign binds an exact SHA-256 of the file
# BYTES. With core.autocrlf=true a fresh clone would materialize these as CRLF (MR-002 v1.1 rev 3:
# 35,053 B LF -> 35,688 B CRLF), producing a different hash and silently voiding the binding.
docs/implementation/TradingWorkbench_MR002_PreRegistration_*.md text eol=lf

# The Phase-3C adoption binding (phase3c/adopted.py) re-hashes this file at import and compares
# against its LF Git-blob sha. Without an eol pin it checks out CRLF on Windows and the binding
# fail-closes locally even though the blob is correct — the same trap the phase3c dirs already
# pin against. The file's committed bytes are unchanged; only the checkout is pinned.
apps/backend/scripts/mr002_development_run.py text eol=lf
# rehearsal fixture builder: its bytes are provenance for the frozen fixture hashes
apps/backend/scripts/mr002_v2_build_rehearsal_fixtures.py text eol=lf
apps/backend/scripts/mr002_v2_execution_closure.py text eol=lf
apps/backend/scripts/mr002_v2_fold_gate_rehearsal.py text eol=lf
apps/backend/scripts/mr002_v2_tree_aggregate.py text eol=lf
apps/backend/scripts/mr002_v2_build_deployment_artifact.py text eol=lf
apps/backend/scripts/mr002_v2_boundary_probe.py text eol=lf

# Gate 11 (owner ruling 2026-08-21), the resource-side counterpart to Amendment A. The HEAD
# authorization probe's sha256 is BOUND in readiness v5.0 as the instrument identity, and the
# staged host-side copy is verified equal to the Git blob — a CRLF checkout would break both.
# Same trap family as the v3.5 CRLF retirement and the phase3c adoption binding.
apps/backend/scripts/mr002_v2_head_authorization_probe.py text eol=lf
apps/backend/scripts/mr002_v2_resource_policy_gate.py text eol=lf
scripts/mr002_custody/validation2_resource_policy_amendment.py text eol=lf
# custody copies of live AWS policy documents: byte custody, not just canonical-JSON equality
scripts/mr002_custody/aws/*.json text eol=lf
scripts/mr002_custody/consumed_validation2_custody_denial.py text eol=lf
scripts/mr002_custody/consumed_holdout_custody_denial_v2.py text eol=lf
apps/backend/scripts/mr002_host_decommissioning_sweep.py text eol=lf

# SEC-001 V3 crawl driver — bytes in the worktree must equal bytes in the Git blob.
# Governance hashes are taken from this package; CRLF normalisation would make the
# worktree copy and the object store disagree, which is exactly the failure that cost
# the 2026-08-24 arrival gate a rebuild (5 of 6 blobs rejected).
apps/backend/app/altdata/sec001_v3/** -text
apps/backend/tests/altdata/sec001_v3/** -text

# SEC-001 V3.1 WP0A-Q cover-page acquisition -- same byte-custody requirement as V3 above.
# WP0AQ_COVER_ENVELOPE_V1.json is CREATE-ONCE and its sha256 IS the governance identity
# recorded in the selection record and in the memory state; CRLF normalisation would make
# the worktree copy and the object store disagree (worktree f10c1ad1 vs normalised f833217d).
artifacts/wp0aq/** -text
apps/backend/scripts/sec001_v31_wp0aq_envelope.py -text

# The sealed WP0A-Q manifest is hash-verified at runtime by the acquisition authority
# loader, so its worktree bytes must equal its blob bytes in every checkout. Without this
# a fresh clone on a core.autocrlf=true machine materialises it CRLF and it hashes to
# 19dc1e3a instead of the governed 3a30ad02, and the authority fails closed.
manifests/wp0aq/** -text
